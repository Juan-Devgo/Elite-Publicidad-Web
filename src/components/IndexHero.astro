---
import { Image } from "astro:assets";
import { type Media } from "../../types/media";
import type { CallToAction as CTA, Texto } from "../../types/contenido";
import RichText from "./ui/RichText.astro";
import CallToAction from "./ui/CallToAction.astro";

interface Props {
  titulo?: string;
  mensaje?: Texto;
  media?: Media | null;
  callToAction?: CTA | null;
}

const { titulo, mensaje, media, callToAction } = Astro.props;

/* Los PNG suelen venir con fondo transparente (logos, recortes): en vez de
   taparlos con las capas negras del hero, se les pone detrás el fondo oscuro
   con destellos, igual que en las páginas de servicios. */
const esPng = /\.png(\?|$)/i.test(media?.url ?? "");
const esImagenRecortada = media?.type === "image" && esPng;
---

<header
  class="relative h-screen flex items-center justify-start text-left text-white overflow-hidden"
>
  <!-- Fondo oscuro con destellos detrás de los PNG recortados -->

  {
    esImagenRecortada && (
      <>
        <div class="absolute inset-0 fondo-oscuro" />
        <div
          class="pointer-events-none absolute inset-0"
          style="background: radial-gradient(55% 55% at 78% 30%, #02EFD61f 0%, transparent 65%);"
        />
        <div class="pointer-events-none absolute -right-24 top-1/4 h-72 w-72 rounded-full bg-secondary/10 blur-3xl" />
      </>
    )
  }

  <!-- Renderizado condicional del media, escoge entre imagen o video -->

  {
    media?.url && media.type === "image" && (
      <Image
        src={media.url}
        alt={media.alt ?? "Imagen de fondo"}
        width={media.width ?? 1920}
        height={media.height ?? 1080}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    )
  }

  {
    media?.url && media.type === "video" && (
      <video
        class="absolute inset-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
      >
        <source src={media.url} type="video/mp4" />
        {media.alt ?? "Tu navegador no soporta la etiqueta de video."}
      </video>
    )
  }

  <!-- Si no hay media o es desconocido, mostramos un fondo oscuro -->

  {
    !media?.url || media.type === "unknown" ? (
      <div class="absolute inset-0 fondo-oscuro" />
    ) : (
      !esImagenRecortada && <div class="absolute inset-0 bg-black/50" />
    )
  }

  {/* Un velo negro plano apagaría el PNG, así que sobre él solo se oscurece
      el costado del texto y se deja respirar el resto. */}
  {
    esImagenRecortada ? (
      <div class="absolute inset-0 bg-linear-to-r from-black/85 via-black/45 to-transparent" />
    ) : (
      <div class="absolute inset-0 bg-black/70" />
    )
  }

  <!-- Contenido del hero -->

  <div
    class="relative z-10 max-w-3xl w-full mx-auto px-6 sm:px-10 lg:px-16 py-16 font-hero"
  >
    {
      titulo && (
        <h1
          class="text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-4 text-white
        [text-shadow:0_0_2px_#fff,0_0_8px_#fff,0_0_16px_#02EFD6,0_0_32px_#02EFD6,0_0_64px_#02EFD6]
        animate-blurred-fade-in animate-duration-400"
        >
          {titulo}
        </h1>
      )
    }
    {
      mensaje && (
        <RichText
          contenido={mensaje}
          class="text-sm sm:text-base md:text-lg lg:text-xl text-white/80 mb-10 max-w-xl leading-relaxed animate-pulse-fade-in animation-delay-500"
        />
      )
    }

    {
      callToAction?.label && (
        <CallToAction
          label={callToAction.label}
          href={callToAction.href}
          nuevaPestania={callToAction.nuevaPestania}
        />
      )
    }
  </div>
</header>
