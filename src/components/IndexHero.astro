---
import { Image } from 'astro:assets';
import { type Media } from '../../types/media';
import Button from './ui/Button.astro';

interface Props {
  titulo: string;
  subtitulo: string;
  media: Media;
  callToAction: {
    label: string;
    href: string;
    nuevaPestania: boolean;
  };
}

const { titulo, subtitulo, media, callToAction } = Astro.props;

console.log('Tipo de media recibido en IndexHero:', media.type);
---

<header
  class="relative min-h-[60vh] flex items-center justify-start text-left text-white overflow-hidden"
>
  <!-- Renderizado condicional del media, escoge entre imagen o video -->

  {
    media.url && media.type === 'image' && (
      <Image
        src={media.url}
        alt={media.alt ?? 'Imagen de fondo'}
        width={media.width ?? 1920}
        height={media.height ?? 1080}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    )
  }

  {
    media.url && media.type === 'video' && (
      <video
        class="absolute inset-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
      >
        <source src={media.url} type="video/mp4" />
        {media.alt ?? 'Tu navegador no soporta la etiqueta de video.'}
      </video>
    )
  }

  <!-- Si no hay media o es desconocido, mostramos un fondo oscuro -->

  {
    !media.url || media.type === 'unknown' ? (
      <div class="absolute inset-0 bg-slate-900" />
    ) : (
      <div class="absolute inset-0 bg-black/50" />
    )
  }

  <div class="absolute inset-0 bg-black/70"></div>

  <!-- Contenido del hero -->

  <div class="relative z-10 max-w-3xl mx-10 px-4">
    {titulo && <h1 class="text-3xl md:text-5xl font-bold mb-4">{titulo}</h1>}
    {subtitulo && <p class="text-lg md:text-2xl mb-6">{subtitulo}</p>}

    {
      callToAction && (
        <a
          href={callToAction.href}
          target={callToAction.nuevaPestania ? '_blank' : '_self'}
          rel={callToAction.nuevaPestania ? 'noopener noreferrer' : undefined}
          class="inline-block py-3 rounded-md bg-accent hover:bg-accent/90 transition"
        >
          <Button>{callToAction.label}</Button>
        </a>
      )
    }
  </div>
</header>
