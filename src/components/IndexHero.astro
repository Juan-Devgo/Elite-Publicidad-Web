---
import { Image } from "astro:assets";
import { type Media } from "../../types/media";
import {
  BlocksRenderer,
  type BlocksContent,
} from "@strapi/blocks-react-renderer";
import CallToAction from "./ui/CallToAction.astro";

interface Props {
  titulo: string;
  mensaje: BlocksContent;
  media: Media;
  callToAction: {
    label: string;
    href: string;
    nuevaPestania: boolean;
  };
}

const { titulo, mensaje, media, callToAction } = Astro.props;

console.log("Tipo de media recibido en IndexHero:", media.type);
---

<header
  class="relative h-screen flex items-center justify-start text-left text-white overflow-hidden"
>
  <!-- Renderizado condicional del media, escoge entre imagen o video -->

  {
    media.url && media.type === "image" && (
      <Image
        src={media.url}
        alt={media.alt ?? "Imagen de fondo"}
        width={media.width ?? 1920}
        height={media.height ?? 1080}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    )
  }

  {
    media.url && media.type === "video" && (
      <video
        class="absolute inset-0 w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
      >
        <source src={media.url} type="video/mp4" />
        {media.alt ?? "Tu navegador no soporta la etiqueta de video."}
      </video>
    )
  }

  <!-- Si no hay media o es desconocido, mostramos un fondo oscuro -->

  {
    !media.url || media.type === "unknown" ? (
      <div class="absolute inset-0 bg-slate-900" />
    ) : (
      <div class="absolute inset-0 bg-black/50" />
    )
  }

  <div class="absolute inset-0 bg-black/70"></div>

  <!-- Contenido del hero -->

  <div
    class="relative z-10 max-w-3xl w-full mx-auto px-6 sm:px-10 lg:px-16 py-16 font-hero"
  >
    {
      titulo && (
        <h1
          class="text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-4 text-white
        [text-shadow:0_0_2px_#fff,0_0_8px_#fff,0_0_16px_#02EFD6,0_0_32px_#02EFD6,0_0_64px_#02EFD6]
        animate-blurred-fade-in animate-duration-400"
        >
          {titulo}
        </h1>
      )
    }
    {
      mensaje && (
        <div class="text-sm sm:text-base md:text-lg lg:text-xl text-white/80 mb-10 max-w-xl leading-relaxed animate-pulse-fade-in animation-delay-500">
          <BlocksRenderer client:load content={mensaje} />
        </div>
      )
    }

    {
      callToAction && (
        <CallToAction
          label={callToAction.label}
          href={callToAction.href}
          nuevaPestania={callToAction.nuevaPestania}
        />
      )
    }
  </div>
</header>
