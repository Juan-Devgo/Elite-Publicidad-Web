---
import { Image } from 'astro:assets';
import type { RedSocial } from '../../types/contenido';

interface Props {
  className: string;
  redes: RedSocial[];
  size: number;
}

const { className, redes, size } = Astro.props;
console.log('Props recibidos en SocialNetworks:', { className, redes, size });
---

<div class={className}>
  {
    redes.map((red: RedSocial) => (
      <a
        class="block transition-transform hover:scale-125"
        href={red.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Image
          src={red.icono.url ?? ""}
          alt={red.icono.alt ?? `Logo de ${red.nombre ?? 'Red Social'}`}
          width={size}
          height={size}
        />
      </a>
    ))
  }
</div>
