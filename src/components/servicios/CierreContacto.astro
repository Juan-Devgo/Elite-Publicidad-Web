---
import CallToAction from "../ui/CallToAction.astro";
import RichText from "../ui/RichText.astro";
import Phone from "../icons/Phone.astro";
import WhatsApp from "../icons/WhatsApp.astro";
import type { Cierre } from "../../../types/contenido";

interface Props {
  cierre?: Cierre | null;
}

const { cierre } = Astro.props;

const telefonoLimpio = cierre?.telefono?.replace(/\D/g, "");
const whatsappLimpio = cierre?.whatsapp?.replace(/\D/g, "");
const whatsappHref = whatsappLimpio
  ? `https://wa.me/${whatsappLimpio}` +
    (cierre?.whatsappMensaje
      ? `?text=${encodeURIComponent(cierre.whatsappMensaje)}`
      : "")
  : null;
---

{
  cierre?.titulo && (
    <section class="relative overflow-hidden fondo-oscuro py-20 sm:py-24">
      <div
        class="pointer-events-none absolute inset-0"
        
      />

      <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
        <p class="text-secondary text-[10px] font-bold uppercase tracking-[0.25em] sm:text-xs">
          Hablemos de tu proyecto
        </p>

        <h2 class="font-hero mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl md:text-5xl">
          {cierre.titulo}
        </h2>

        {cierre.mensaje && (
          <RichText
            contenido={cierre.mensaje}
            class="mt-5 text-sm leading-relaxed text-white/60 sm:text-base"
          />
        )}

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          {cierre.callToAction?.label && (
            <CallToAction
              label={cierre.callToAction.label}
              href={cierre.callToAction.href}
              nuevaPestania={cierre.callToAction.nuevaPestania}
            />
          )}

          {whatsappHref && (
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 rounded-lg border-2 border-white/20 px-6 py-3 text-xs font-bold uppercase tracking-widest text-white transition-all duration-300 hover:border-secondary hover:text-secondary sm:px-8 sm:py-4 sm:text-sm"
            >
              <WhatsApp className="h-4 w-4 fill-current" />
              WhatsApp
            </a>
          )}
        </div>

        {telefonoLimpio && (
          <a
            href={`tel:${telefonoLimpio}`}
            class="mt-8 inline-flex items-center gap-2 text-sm text-white/50 transition-colors hover:text-secondary"
          >
            <Phone />
            <span>{cierre.telefono}</span>
          </a>
        )}
      </div>
    </section>
  )
}
