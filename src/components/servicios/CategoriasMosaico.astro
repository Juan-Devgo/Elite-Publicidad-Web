---
import { Image } from "astro:assets";
import type { Categoria } from "../../../types/contenido";

interface Props {
  categorias: Categoria[];
  tono?: "claro" | "oscuro";
}

const { categorias = [] } = Astro.props;

/* Con pocas categorías se usan dos columnas para que cada mosaico ocupe más
   espacio; el flex-wrap centra la última fila cuando queda incompleta. */
const dosColumnas = categorias.length <= 2 || categorias.length === 4;
const anchoMosaico = dosColumnas
  ? "lg:w-[calc(50%-0.75rem)]"
  : "lg:w-[calc(33.333%-1rem)]";
---

<div class="mx-auto flex max-w-7xl flex-wrap justify-center gap-6">
  {
    categorias.map((categoria) => (
      <article
        class:list={[
          "group relative w-full min-h-80 overflow-hidden rounded-3xl fondo-oscuro sm:min-h-96 sm:w-[calc(50%-0.75rem)]",
          anchoMosaico,
        ]}
      >
        {categoria.imagen?.url ? (
          <Image
            src={categoria.imagen.url}
            alt={categoria.imagen.alt ?? categoria.nombre}
            width={categoria.imagen.width ?? 1200}
            height={categoria.imagen.height ?? 960}
            class="absolute inset-0 h-full w-full object-cover opacity-80 transition-all duration-700 group-hover:scale-105 group-hover:opacity-100"
            loading="lazy"
          />
        ) : (
          <div class="absolute inset-0 bg-slate-800" />
        )}

        <div class="absolute inset-0 bg-linear-to-t from-black via-black/50 to-transparent" />

        <div class="absolute inset-x-0 bottom-0 p-8 sm:p-10">
          <h3 class="font-hero text-2xl font-bold text-white transition-colors duration-300 group-hover:text-secondary sm:text-3xl lg:text-4xl">
            {categoria.nombre}
          </h3>

          {categoria.descripcion && (
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/65 sm:text-base">
              {categoria.descripcion}
            </p>
          )}

          {categoria.items && categoria.items.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {categoria.items.slice(0, 6).map((item) => (
                <li class="rounded-full border border-white/15 bg-black/30 px-3.5 py-1.5 text-xs font-semibold text-white/70 backdrop-blur-sm transition-colors group-hover:border-secondary/40 group-hover:text-secondary">
                  {item.nombre}
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))
  }
</div>
