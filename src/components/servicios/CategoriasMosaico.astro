---
import { Image } from "astro:assets";
import type { Categoria } from "../../../types/contenido";

interface Props {
  categorias: Categoria[];
  tono?: "claro" | "oscuro";
}

const { categorias = [] } = Astro.props;

// La primera categoría manda: ocupa el doble de alto en escritorio.
const destacada = (i: number) => i === 0;
---

<div
  class="grid auto-rows-[220px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
>
  {
    categorias.map((categoria, i) => (
      <article
        class:list={[
          "group relative overflow-hidden rounded-3xl bg-slate-900",
          destacada(i) && "sm:col-span-2 sm:row-span-2",
        ]}
      >
        {categoria.imagen?.url ? (
          <Image
            src={categoria.imagen.url}
            alt={categoria.imagen.alt ?? categoria.nombre}
            width={categoria.imagen.width ?? 1000}
            height={categoria.imagen.height ?? 800}
            class="h-full w-full object-cover opacity-80 transition-all duration-700 group-hover:scale-105 group-hover:opacity-100"
            loading="lazy"
          />
        ) : (
          <div class="h-full w-full bg-slate-800" />
        )}

        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" />

        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
          <h3
            class:list={[
              "font-hero font-bold text-white transition-colors duration-300 group-hover:text-secondary",
              destacada(i) ? "text-2xl sm:text-3xl" : "text-lg sm:text-xl",
            ]}
          >
            {categoria.nombre}
          </h3>

          {categoria.descripcion && (
            <p
              class:list={[
                "mt-2 text-sm leading-relaxed text-white/65",
                destacada(i)
                  ? "max-w-md"
                  : "line-clamp-2 opacity-0 transition-opacity duration-500 group-hover:opacity-100",
              ]}
            >
              {categoria.descripcion}
            </p>
          )}

          {categoria.items && categoria.items.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {categoria.items.slice(0, destacada(i) ? 6 : 3).map((item) => (
                <li class="rounded-full border border-white/15 bg-black/30 px-3 py-1 text-[11px] font-semibold text-white/70 backdrop-blur-sm transition-colors group-hover:border-secondary/40 group-hover:text-secondary">
                  {item.nombre}
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))
  }
</div>
