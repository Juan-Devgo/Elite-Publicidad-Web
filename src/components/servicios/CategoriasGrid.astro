---
import { Image } from "astro:assets";
import Check from "../icons/Check.astro";
import type { Categoria } from "../../../types/contenido";

interface Props {
  categorias: Categoria[];
  tono?: "claro" | "oscuro";
}

const { categorias = [], tono = "claro" } = Astro.props;
const esOscuro = tono === "oscuro";

/* Con pocas categorías se reparten en dos columnas para que cada tarjeta
   aproveche el ancho disponible y no queden filas huérfanas. */
const dosColumnas = categorias.length <= 2 || categorias.length === 4;
const anchoTarjeta = dosColumnas
  ? "lg:w-[calc(50%-1rem)]"
  : "lg:w-[calc(33.333%-1.334rem)]";
---

<div class="mx-auto flex max-w-7xl flex-wrap justify-center gap-8">
  {
    categorias.map((categoria) => (
      <article
        class:list={[
          "group flex w-full flex-col overflow-hidden rounded-3xl border transition-all duration-500 sm:w-[calc(50%-1rem)]",
          anchoTarjeta,
          esOscuro
            ? "border-white/10 bg-white/3 hover:border-secondary/50 hover:bg-white/6"
            : "border-slate-200 bg-white shadow-sm hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-slate-900/10",
        ]}
      >
        <div class="relative aspect-4/3 overflow-hidden">
          {categoria.imagen?.url ? (
            <Image
              src={categoria.imagen.url}
              alt={categoria.imagen.alt ?? categoria.nombre}
              width={categoria.imagen.width ?? 1000}
              height={categoria.imagen.height ?? 750}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="h-full w-full bg-slate-800" />
          )}
          <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
        </div>

        <div class="flex flex-1 flex-col p-8 sm:p-10">
          <h3
            class:list={[
              "font-hero text-xl font-bold transition-colors duration-300 sm:text-2xl",
              esOscuro
                ? "text-white group-hover:text-secondary"
                : "text-slate-900 group-hover:text-primary",
            ]}
          >
            {categoria.nombre}
          </h3>

          {categoria.descripcion && (
            <p
              class:list={[
                "mt-4 text-sm leading-relaxed sm:text-base",
                esOscuro ? "text-white/55" : "text-slate-600",
              ]}
            >
              {categoria.descripcion}
            </p>
          )}

          {categoria.items && categoria.items.length > 0 && (
            <ul
              class:list={[
                "mt-auto grid gap-x-6 gap-y-2.5 border-t pt-6 text-sm sm:text-base",
                dosColumnas && "sm:grid-cols-2",
                esOscuro ? "border-white/10" : "border-slate-100",
              ]}
            >
              {categoria.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <Check class="mt-1 h-4 w-4 shrink-0 text-secondary" />
                  <span class={esOscuro ? "text-white/70" : "text-slate-700"}>
                    {item.nombre}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))
  }
</div>
