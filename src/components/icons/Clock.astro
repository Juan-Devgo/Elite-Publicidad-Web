---
interface Props {
  class?: string;
}

const { class: className = "w-5 h-5 shrink-0 text-secondary" } = Astro.props;
---

<svg
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"
  ></circle>
  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3.5 2"></path>
</svg>
