---
interface Props {
  class?: string;
}

const { class: className = "w-4 h-4 shrink-0 text-secondary" } = Astro.props;
---

<svg
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"
  ></path>
</svg>
