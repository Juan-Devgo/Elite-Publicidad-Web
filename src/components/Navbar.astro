---
import { Image } from 'astro:assets';
import SocialNetworks from './SocialNetworks.astro';
import type { Media } from '../../types/media';

interface Props {
  logo: Media;
  paginas: {
    nombre: string;
    href: string;
    subpaginas?: {
      nombre: string;
      href: string;
    }[];
  }[];
  redes: {
    icono: Media;
    nombre: string;
    href: string;
  }[];
}

const { logo, paginas, redes } = Astro.props;

console.log('Props recibidos en Navbar:', { logo, paginas, redes });
---

<nav class="bg-[linear-gradient(to_right,#000_10%,#02EFD6_100%)] text-white">
  <div class="flex max-w-6xl mx-auto px-4 py-3 items-center justify-between">
    <a href="/" class="mr-6">
      <Image
        src={logo.url ?? ''}
        alt={logo.alt ?? 'Logo de la empresa'}
        width={logo.width ?? 150}
        height={logo.height ?? 50}
      />
    </a>
    <ul class="flex lg:space-x-16 md:space-x-8 space-x-4 mx-auto items-center">
      {
        paginas.map((pagina) => (
          <li class="relative group">
            <a
              href={pagina.href}
              class="block font-semibold text-2xl transition-transform hover:scale-125"
            >
              {pagina.nombre}
            </a>
            {pagina.subpaginas && pagina.subpaginas.length > 0 && (
              <ul class="absolute left-1/2 -translate-x-1/2 top-full mt-2 bg-white text-black rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 min-w-[200px] z-50">
                {pagina.subpaginas.map((subpagina) => (
                  <li class="hover:bg-primary hover:text-white rounded-lg transition-colors duration-0">
                    <a
                      href={subpagina.href}
                      class="block px-4 py-3 text-lg font-medium text-center"
                    >
                      {subpagina.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <SocialNetworks
      className="flex items-center justify-center gap-5 ml-6"
      redes={redes}
      size={64}
    />
  </div>
</nav>
