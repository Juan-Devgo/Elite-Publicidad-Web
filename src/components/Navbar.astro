---
import { getImage } from "astro:assets";
import type { Media } from "../../types/media";
import NavbarClient from "./NavbarClient";

interface Props {
  logo: Media;
  paginas: {
    nombre: string;
    href: string;
    subpaginas?: {
      nombre: string;
      href: string;
    }[];
  }[];
}

const { logo, paginas } = Astro.props;

const logoImg = await getImage({
  src: logo.url ?? "",
  width: 150,
  height: 50,
});
---

<NavbarClient
  logoSrc={logoImg.src}
  logoAlt={logo.alt ?? "Logo de la empresa"}
  paginas={paginas}
  client:load
/>
