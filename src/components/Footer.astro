---
import { Image } from "astro:assets";
import SocialNetworks from "./SocialNetworks.astro";
import CallToAction from "./ui/CallToAction.astro";
import type { Media } from "../../types/media";
import type { Page, Subpage } from "../../types/layout";

interface Props {
  logo: Media;
  callToAction: {
    label: string;
    href: string;
    nuevaPestania: boolean;
  };
  servicios: Page[];
  conocenos: Subpage[];
  redes: {
    icono: Media;
    nombre: string;
    href: string;
  }[];
  copyright: string;
}

const { logo, callToAction, redes, copyright, servicios, conocenos } = Astro.props;
---

<footer class="bg-black text-white">
  <!-- CTA Banner -->
  <div
    class="border-t border-b border-secondary/30 py-14 px-6 text-center"
    style="background: radial-gradient(ellipse at center, #02EFD608 0%, transparent 70%);"
  >
    <p class="text-secondary uppercase tracking-widest text-xs font-bold mb-3">
      ¿Listo para crecer?
    </p>
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-8"
      style="text-shadow: 0 0 20px #02EFD650;"
    >
      {callToAction.label}
    </h2>
    <CallToAction
      label={callToAction.label}
      href={callToAction.href}
      nuevaPestania={callToAction.nuevaPestania}
    />
  </div>

  <!-- Main footer grid -->
  <div class="max-w-6xl mx-auto px-6 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
    <!-- Logo + redes -->
    <div class="flex flex-col items-start gap-6 sm:col-span-2 lg:col-span-2 mx-auto">
      <a href="/">
        <Image
          src={logo.url ?? ""}
          alt={logo.alt ?? "Logo de la empresa"}
          width={logo.width ?? 150}
          height={logo.height ?? 50}
        />
      </a>
      <SocialNetworks
        className="flex flex-row gap-4 mx-auto"
        redes={redes}
        size={36}
      />
    </div>

    <!-- Servicios -->
    <div>
      <h3 class="text-secondary uppercase tracking-widest text-md font-bold mb-4 pb-2 border-b border-secondary/30">
        Servicios
      </h3>
      <ul class="space-y-2">
        {servicios.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-white/60 hover:text-secondary transition-colors duration-200 text-md"
            >
              {item.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Conócenos -->
    <div>
      <h3 class="text-secondary uppercase tracking-widest text-md font-bold mb-4 pb-2 border-b border-secondary/30">
        Conócenos
      </h3>
      <ul class="space-y-2">
        {conocenos.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-white/60 hover:text-secondary transition-colors duration-200 text-md"
            >
              {item.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-secondary/20 px-6 py-4 text-center text-white/40 text-xs">
    {copyright}
  </div>
</footer>
