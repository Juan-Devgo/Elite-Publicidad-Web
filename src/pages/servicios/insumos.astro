---
import { getServicio } from "../../../lib/content-manager";
import { mapServicio } from "../../../lib/utils";
import Main from "../../layouts/main.astro";
import ServicioTemplate from "../../components/servicios/ServicioTemplate.astro";
import CategoriasLista from "../../components/servicios/CategoriasLista.astro";

const servicio = mapServicio(await getServicio("insumos"));

const titulo = servicio.titulo ?? "Insumos";
---

<Main
  titulo={servicio.metaTitulo ?? `${titulo} | Élite Publicidad`}
  descripcion={servicio.metaDescripcion}
>
  <ServicioTemplate {...servicio} titulo={titulo} categoriasTono="claro">
    <CategoriasLista
      slot="categorias"
      categorias={servicio.categorias}
      tono="claro"
    />
  </ServicioTemplate>
</Main>
