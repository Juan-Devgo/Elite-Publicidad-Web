---
import { getServicio } from "../../../lib/content-manager";
import { mapServicio } from "../../../lib/utils";
import Main from "../../layouts/main.astro";
import ServicioTemplate from "../../components/servicios/ServicioTemplate.astro";
import CategoriasMosaico from "../../components/servicios/CategoriasMosaico.astro";

const servicio = mapServicio(await getServicio("visibilidad"));

const titulo = servicio.titulo ?? "Visibilidad";
---

<Main
  titulo={servicio.metaTitulo ?? `${titulo} | Élite Publicidad`}
  descripcion={servicio.metaDescripcion}
>
  <ServicioTemplate
    {...servicio}
    titulo={titulo}
    categoriasTono="oscuro"
    trabajosTono="claro"
  >
    <CategoriasMosaico
      slot="categorias"
      categorias={servicio.categorias}
      tono="oscuro"
    />
  </ServicioTemplate>
</Main>
